{
	"name": "@nxgt/ai-anthropic",
	"version": "0.2.0",
	"description": "Anthropic Messages API adapter for @nxgt/ai-core on Bun fetch, with no third-party client",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"anthropic",
		"claude",
		"bun",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-ai.git",
		"directory": "packages/ai-anthropic"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@nxgt/ai-core": "workspace:^",
		"@nxgt/ai-testing": "workspace:^",
		"@types/bun": "^1.4.4",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"@nxgt/ai-core": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
